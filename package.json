{
  "name": "turnfu",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "bench:hybrid": "node --experimental-strip-types scripts/benchmark-hybrid.ts",
    "bench:rust-wasm:parallel": "node --experimental-strip-types scripts/benchmark-rust-wasm-parallel.ts",
    "search:rust-wasm": "node --experimental-strip-types scripts/search-rust-wasm-sqlite.ts",
    "bench:wasm": "node --experimental-strip-types scripts/benchmark-rust-wasm.ts",
    "wasm:build": "wasm-pack build rust/optimizer-wasm --target nodejs --out-dir ../../src/wasm/optimizer_wasm_pkg",
    "wasm:test": "cargo test --manifest-path rust/optimizer-wasm/Cargo.toml",
    "diff:rust-wasm": "node --experimental-strip-types scripts/differential-rust-wasm.ts",
    "diff:rust-wasm:ci": "node --experimental-strip-types scripts/differential-rust-wasm.ts --profile ci",
    "diff:rust-wasm:soak": "node --experimental-strip-types scripts/differential-rust-wasm.ts --profile soak",
    "validate:openspec:huppermage": "openspec validate catalog-huppermage-spells-effects --strict --no-interactive"
  },
  "dependencies": {
    "lucide-react": "1.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "6.0.3",
    "vite": "8.0.14"
  }
}
